# Cloudflare R2 S3-compatible credentials for the DVC data remote.
# Copy this file to .env and fill in the values locally. Never commit .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
AWS_REGION=auto

# Non-secret metadata used when configuring the M5 DVC remote.
DVC_REMOTE_NAME=r2
DVC_BUCKET=telco-churn-data

# M9 local runtime (the bundle is mounted read-only and is never built into the image).
TELCO_CHURN_IMAGE_TAG=<git-sha>
TELCO_CHURN_BUNDLE_DIR=<absolute-path-to-m3-bundle>
TELCO_CHURN_API_PORT=8000
TELCO_CHURN_LOG_LEVEL=info
# Copy the three values from the mounted bundle's model_manifest.json.
TELCO_CHURN_DECISION_THRESHOLD=<manifest-decision-threshold>
TELCO_CHURN_LOW_RISK_THRESHOLD=<manifest-risk-bands-low>
TELCO_CHURN_HIGH_RISK_THRESHOLD=<manifest-risk-bands-high>
